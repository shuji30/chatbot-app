# このファイルを .env.local にコピーして値を設定する(.env.local は git 管理外)
# 設定変更後は各サーバーの再起動が必要(GEMINI_API_KEY → プロキシ、REACT_APP_* → CRA)

# Gemini API キー(Google AI Studio https://aistudio.google.com/ で取得。無料枠あり)
# プロキシサーバー(server/index.mjs)だけが読む。REACT_APP_ を付けないこと —
# 付けるとフロントのバンドルに埋め込まれてしまう(旧名 REACT_APP_GEMINI_API_KEY も移行用に読まれる)
GEMINI_API_KEY=AIza...

# 質問対象のサイト URL(ヘッダーの入力欄の初期値。画面から変更可能)
REACT_APP_TARGET_SITE_URL=https://example.com/
